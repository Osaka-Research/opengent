# opengent Caddyfile — TLS termination only. All routing to per-user ttyd
# instances is dynamic (slug -> port looked up from Postgres/Redis), done
# by the gateway service, not by Caddy config. Caddy never changes after
# this file is written once at setup — no reload on signup/teardown.
# Caddy auto-provisions Let's Encrypt certs for the domain below; just
# point its A record at this VPS first.

{$OPENGENT_DOMAIN} {
    # Registration API (install.sh POSTs here to claim/release a slug).
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy 127.0.0.1:8790
    }

    # Everything else: gateway resolves the slug and proxies to it
    # (including websocket upgrades, for the terminal itself).
    reverse_proxy 127.0.0.1:8791
}
